{
  "name": "vivid-charts",
  "version": "0.2.0",
  "description": "Poster-grade data visualization for humans and AI agents: Visual Capitalist-style infographics (photos, maps, treemaps, streamgraphs, bubble chains\u2026) from a JSON spec, rendered to SVG/PNG without a browser. Ships with an agent skill.",
  "type": "module",
  "license": "MIT",
  "author": "Ahmet Dedeler",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ahmet-Dedeler/vivid-charts.git"
  },
  "keywords": [
    "dataviz",
    "data-visualization",
    "infographic",
    "charts",
    "svg",
    "png",
    "poster",
    "treemap",
    "streamgraph",
    "choropleth",
    "agent-skill",
    "claude",
    "ai-agents",
    "visual-capitalist"
  ],
  "bin": {
    "vivid": "./dist/cli.js",
    "vivid-charts": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fonts",
    "data",
    "skill",
    "examples",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --clean --target node20 && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "vivid": "tsx src/cli.ts",
    "examples": "tsx scripts/render-examples.ts",
    "prepare": "tsup src/index.ts src/cli.ts --format esm --clean --target node20 && tsc -p tsconfig.build.json",
    "test": "tsx test/smoke.ts"
  },
  "dependencies": {
    "@iconify-json/fluent-emoji-flat": "^1.2.6",
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.99",
    "@iconify/utils": "^3.1.7",
    "@resvg/resvg-js": "^2.6.2",
    "d3-array": "^3.2.4",
    "d3-color": "^3.1.0",
    "d3-geo": "^3.1.1",
    "d3-hierarchy": "^3.1.2",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-voronoi-treemap": "^1.1.2",
    "flag-icons": "^7.5.0",
    "i18n-iso-countries": "^7.14.0",
    "opentype.js": "^2.0.0",
    "pngjs": "^7.0.0",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-color": "^3.1.3",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.4",
    "@types/opentype.js": "^1.3.10",
    "@types/pngjs": "^6.0.5",
    "@types/topojson-client": "^3.1.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "homepage": "https://github.com/Ahmet-Dedeler/vivid-charts#readme",
  "bugs": {
    "url": "https://github.com/Ahmet-Dedeler/vivid-charts/issues"
  },
  "packageManager": "pnpm@10.16.1",
  "publishConfig": {
    "access": "public"
  }
}